      ],
      "widgets_values_named": {
        "storyboard": "{\n  \"title\": \"卧室缠绵示例\",\n  \"prefix\": \"bedroom_intimate\",\n  \"final_name\": \"卧室缠绵_成片.mp4\",\n  \"workflow\": \"D:/Comfy-Desktop/.workbuddy/skills/h3-long-video/assets/H3-SelfLift_单图参考.base.json\",\n  \"ref_image\": \"D:/Comfy-Desktop/output/卧室缠绵/refs/girl_ref.png\",\n  \"comfy_ref_name\": \"bedroom_girl_ref.png\",\n  \"bg_plate\": \"bedroom_bg_plate.png\",\n  \"bg_plate_path\": \"D:/Comfy-Desktop/output/卧室缠绵/refs/bg_plate.png\",\n  \"megapixels\": 0.5,\n  \"seconds\": 5.0,\n  \"length\": 124,\n  \"fps\": 24,\n  \"join_mode\": \"dissolve\",\n  \"join_dissolve_seconds\": 0.25,\n  \"head\": \"<Picture 1> 是人物参考，完全还原图中女生的脸型、五官、发型、发色与身材比例，同一个人，全程五官、发型与服装不变。\\n\\n<Picture 2> 是全片唯一的场景空镜参考，卧室结构、床铺位置、窗帘与光源方向全程以它为准，保持不变。\",\n  \"tail\": \"写实电影摄影，35mm 镜头，柔和浅景深，真实光学散景，细腻胶片颗粒。暖色室内光，窗边柔光。画面中只有她和男人两个人，不出现文字、水印、字幕。\\n\\n[衔接] 段首约 0.5 秒人物动作与镜头保持稳定，随后开始本段动作；段尾约 0.5 秒动作收住、保持稳定。\",\n  \"segments\": [\n    {\n      \"id\": \"s01\",\n      \"title\": \"起手（无首帧：P1=人物，P2=空镜板）\",\n      \"seed\": 582101,\n      \"head\": \"<Picture 1> 是人物参考，完全还原图中女生的脸型、五官、发型、发色与身材比例，同一个人，全程五官、发型与服装不变。\\n\\n<Picture 2> 是全片唯一的场景空镜参考，卧室结构、床铺位置、窗帘与光源方向全程以它为准，保持不变。\",\n      \"body\": \"她坐在床边，侧身对着镜头，男人从身后轻轻环住她的腰。她微微转头，两人额头相抵，呼吸靠近。镜头固定中景，轻微侧拍，背景是<Picture 2>里的卧室，虚化柔和。窗外暖光从左侧洒进来。\"\n    },\n    {\n      \"id\": \"s02\",\n      \"title\": \"链式承接（P1=上段尾帧，P2=人物，P3=空镜板）\",\n      \"seed\": 582113,\n      \"link\": {\n        \"mode\": \"chain\",\n        \"transition\": \"dissolve\"\n      },\n      \"head\": \"<Picture 1> 是本段的首帧，也是上一段的最后一帧，本段必须从这一帧的构图、人物位置和姿态无缝延续，不要重新起幅。\\n\\n<Picture 2> 是人物参考，还原图中女生的脸型、五官、发型、发色与身材比例，与<Picture 1>里是同一个人。\\n\\n<Picture 3> 是全片唯一的场景空镜参考，卧室结构、床铺位置、窗帘与光源方向全程以它为准，保持不变。\",\n      \"body\": \"男人低头轻吻她的侧脸和耳廓，她闭眼，手轻轻覆上他的手臂。两人身体更贴近，动作缓慢温柔。镜头保持机位，只做极缓慢的推近。光线与上一段一致。\"\n    },\n    {\n      \"id\": \"s03\",\n      \"title\": \"链式承接\",\n      \"seed\": 582127,\n      \"link\": {\n        \"mode\": \"chain\",\n        \"transition\": \"dissolve\"\n      },\n      \"head\": \"<Picture 1> 是本段的首帧，也是上一段的最后一帧，本段必须从这一帧的构图、人物位置和姿态无缝延续，不要重新起幅。\\n\\n<Picture 2> 是人物参考，还原图中女生的脸型、五官、发型、发色与身材比例，与<Picture 1>里是同一个人。\\n\\n<Picture 3> 是全片唯一的场景空镜参考，卧室结构、床铺位置、窗帘与光源方向全程以它为准，保持不变。\",\n      \"body\": \"她转身面对男人，双手环上他的脖子，两人嘴唇轻触后加深亲吻。她微微仰头，睫毛轻颤。镜头缓慢推成近景，背景继续虚化。\"\n    },\n    {\n      \"id\": \"s04\",\n      \"title\": \"链式承接\",\n      \"seed\": 582141,\n      \"link\": {\n        \"mode\": \"chain\",\n        \"transition\": \"dissolve\"\n      },\n      \"head\": \"<Picture 1> 是本段的首帧，也是上一段的最后一帧，本段必须从这一帧的构图、人物位置和姿态无缝延续，不要重新起幅。\\n\\n<Picture 2> 是人物参考，还原图中女生的脸型、五官、发型、发色与身材比例，与<Picture 1>里是同一个人。\\n\\n<Picture 3> 是全片唯一的场景空镜参考，卧室结构、床铺位置、窗帘与光源方向全程以它为准，保持不变。\",\n      \"body\": \"亲吻结束后，她把头靠在男人肩上，他轻抚她的后背和发丝。两人相拥，呼吸渐渐平稳。镜头保持近景，轻微左右摇移，动作克制而亲密。\"\n    },\n    {\n      \"id\": \"s05\",\n      \"title\": \"链式承接\",\n      \"seed\": 582155,\n      \"link\": {\n        \"mode\": \"chain\",\n        \"transition\": \"dissolve\"\n      },\n      \"head\": \"<Picture 1> 是本段的首帧，也是上一段的最后一帧，本段必须从这一帧的构图、人物位置和姿态无缝延续，不要重新起幅。\\n\\n<Picture 2> 是人物参考，还原图中女生的脸型、五官、发型、发色与身材比例，与<Picture 1>里是同一个人。\\n\\n<Picture 3> 是全片唯一的场景空镜参考，卧室结构、床铺位置、窗帘与光源方向全程以它为准，保持不变。\",\n      \"body\": \"她抬起头，再次与男人对视，嘴角带着浅笑，然后主动再一次轻轻吻他。男人回应，手掌贴在她腰侧。镜头缓慢后拉回中近景，房间细节重新隐约可见。\"\n    },\n    {\n      \"id\": \"s06\",\n      \"title\": \"收尾\",\n      \"seed\": 582169,\n      \"link\": {\n        \"mode\": \"chain\",\n        \"transition\": \"dissolve\"\n      },\n      \"head\": \"<Picture 1> 是本段的首帧，也是上一段的最后一帧，本段必须从这一帧的构图、人物位置和姿态无缝延续，不要重新起幅。\\n\\n<Picture 2> 是人物参考，还原图中女生的脸型、五官、发型、发色与身材比例，与<Picture 1>里是同一个人。\\n\\n<Picture 3> 是全片唯一的场景空镜参考，卧室结构、床铺位置、窗帘与光源方向全程以它为准，保持不变。\",\n      \"body\": \"两人额头相抵，安静对视片刻，随后一起缓缓倒向床铺，侧身相拥。镜头固定中景，动作收住，画面稳定结束。光线温暖，氛围安静亲密。\"\n    }\n  ]\n}",
